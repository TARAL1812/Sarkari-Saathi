# Copy to .env and replace placeholders. Never commit real secrets.

NODE_ENV=development
PORT=3001

# SQLite file. Relative paths are resolved from the project root.
DATABASE_PATH=./data/sarkari-saathi.db

# Comma-separated browser origins for CORS and CSRF origin checks.
# API clients (curl, Postman) without an Origin header are still allowed.
FRONTEND_ORIGIN=http://localhost:5173

# Session cookie lifetime in days.
SESSION_TTL_DAYS=7

# Force Secure cookies. Defaults to true in production.
# COOKIE_SECURE=false

# Failed login/register attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=20

# Set to a number (hop count) or "1" if the API sits behind a reverse proxy.
# TRUST_PROXY=

# Optional: create a first admin during `npm run db:seed` only if both are set.
# Leave blank in source control. Do not reuse these values in production.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=ChangeMe_admin1
# SEED_ADMIN_NAME=Demo Admin
