{
  "name": "sarkari-saathi-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone Express + SQLite API for Sarkari Saathi (JourneyMap). Independent of the React frontend.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --import ./tests/registerEnv.js --test --test-concurrency=1 tests/*.test.js",
    "admin:create": "node src/scripts/admin.js create",
    "admin:promote": "node src/scripts/admin.js promote",
    "admin:demote": "node src/scripts/admin.js demote"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
